#!/bin/bash
### Lifecycle script: uninstall_callback

# Kill any remaining tunnel PIDs
if [ -d "${TRIM_PKGVAR}/run" ]; then
    for pfile in "${TRIM_PKGVAR}/run"/tunnel_*.pid; do
        if [ -f "$pfile" ]; then
            pid=$(cat "$pfile" 2>/dev/null)
            if [ -n "$pid" ]; then
                kill -9 "$pid" 2>/dev/null || true
            fi
            rm -f "$pfile"
        fi
    done
fi

pkill -9 -f "tunnel_.*\.toml" 2>/dev/null || true
pkill -9 -f "${TRIM_APPDEST}/bin/frpc" 2>/dev/null || true
pkill -9 -f "/tmp/mslfrp" 2>/dev/null || true

rm -f "${TRIM_APPDEST}/app.sock"
rm -rf "/tmp/mslfrp" "${TRIM_PKGVAR}/run" 2>/dev/null || true

exit 0
